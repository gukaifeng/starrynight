.DS_Store
.local/
build/
**/Library/
**/Temp/
**/Obj/
**/Logs/
**/UserSettings/
**/DerivedData/
**/xcuserdata/
*.xcuserstate
ios/Config/Local.xcconfig
ios/CharacterHost-NativeUI.xcodeproj/
ios/StarryNight-NativeUI.xcworkspace/
*.mobileprovision
*.p12
*.pfx
*.cer
__pycache__/
.venv/
.pytest_cache/

# Unity automatic scene recovery, retained locally
**/_Recovery/
**/_Recovery.meta
# Unity Performance Testing generates machine/run metadata while exporting.
/unity/CharacterRuntime/Assets/Resources/PerformanceTestRunInfo.json*
/unity/CharacterRuntime/Assets/Resources/PerformanceTestRunSettings.json*

# Local credentials and editor/runtime crash artifacts
.env
.env.*
!.env.example
*.pem
*.key
**/mono_crash.*

# Imported character data is restored locally from licensed sources.
# The public source repository must not contain private-preview model data,
# textures, sampled motion curves, or the generated copies used by Unity/iOS.
/character-packages/imported/
/unity/CharacterRuntime/Assets/CharacterPackages/
/unity/CharacterRuntime/Assets/CharacterPackages.meta
/unity/CharacterRuntime/Assets/MikuCharacter/
/unity/CharacterRuntime/Assets/MikuCharacter.meta
/unity/CharacterRuntime/Assets/RealCharacter/
/unity/CharacterRuntime/Assets/RealCharacter.meta
/unity/CharacterRuntime/Assets/ThirdParty/MakeHuman/
/unity/CharacterRuntime/Assets/ThirdParty/MakeHuman.meta
/unity/CharacterRuntime/Assets/Prefabs/Package_*.prefab*
/unity/CharacterRuntime/Assets/Prefabs/HatsuneMiku.prefab*
/unity/CharacterRuntime/Assets/Prefabs/RealWoman.prefab*
/unity/CharacterRuntime/Assets/Resources/Characters/
/unity/CharacterRuntime/Assets/Resources/Characters.meta
# BuildIos.Setup regenerates the scene, including private avatar prefab overrides.
/unity/CharacterRuntime/Assets/Scenes/ViewerScene.unity
/ios/CharacterHost/Resources/CharacterCatalog.json

# Generated character portraits/covers are rebuilt with the local model assets.
/ios/CharacterHost/Assets.xcassets/Cover_*.imageset/
/ios/CharacterHost/Assets.xcassets/Avatar_*.imageset/
/unity/CharacterRuntime/Assets/Resources/Atmospheres/
/unity/CharacterRuntime/Assets/Resources/Atmospheres.meta
/unity/CharacterRuntime/Assets/ArchivedAtmospheres/
/unity/CharacterRuntime/Assets/ArchivedAtmospheres.meta
/ios/CharacterHost/Resources/Music_*_theme.caf
/ios/CharacterHost/Resources/Assets.xcassets/Anime_*.imageset/
/ios/CharacterHost/Resources/Assets.xcassets/MikuThumbnail*.imageset/
/ios/CharacterHost/Resources/Assets.xcassets/HumanThumbnail*.imageset/
/ios/CharacterHost/Resources/Assets.xcassets/Package_*.imageset/
/ios/CharacterHost/Resources/Assets.xcassets/FirstCompanionBackdrop.imageset/

# Keep written verification findings in Git; raw captures and source audits
# remain on the development machine. Existing tracked baseline evidence stays.
/docs/verification/**
!/docs/verification/**/
!/docs/verification/**/*.md

# SDK archives are reproducible from the tracked SDK source and examples.
/docs/character-standard/deliverables/
/docs/environment-standard/deliverables/
# Generated opening voices stay local with the licensed character media.
ios/CharacterHost/Resources/Opening_*.pcm
