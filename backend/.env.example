# Copy to .env for a container-only local environment. Never use this public
# development password on a reachable production database.
POSTGRES_USER=starry
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=starry
DATABASE_URL=postgres://starry:local-development-only@127.0.0.1:55432/starry?sslmode=disable
REDIS_URL=redis://127.0.0.1:56379/0
STARRY_ENV=development
STARRY_LISTEN=127.0.0.1:8090
ALLOW_TEST_GUEST=true
DB_POOL_SIZE=16

# Optional private Python AI worker. This token is server-to-server only.
AI_UPSTREAM_URL=
AI_SERVICE_TOKEN=
