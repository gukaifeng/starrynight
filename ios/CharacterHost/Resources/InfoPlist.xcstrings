{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "星夜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "星夜"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StarryNight"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住说话时，语音发送至星夜 AI 服务及阿里云百炼，实时转成可编辑文字。发送后才进入对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住說話時，語音傳送至星夜 AI 服務及阿里雲百煉，即時轉成可編輯文字。傳送後才進入對話。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While you hold to talk, audio is sent to StarryNight and Alibaba Cloud Bailian for an editable transcript. It enters the conversation only when you send it."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你的语音转成文字，确认后发送给角色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你的語音轉成文字，確認後傳送給角色。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn your speech into text for you to review and send to your character."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发版连接同一网络中的星夜 AI 服务，完成真实对话和语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發版連接同一網路中的星夜 AI 服務，完成真實對話和語音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This development build connects to the StarryNight AI service on your local network for conversations and voice."
          }
        }
      }
    }
  },
  "version": "1.0"
}
