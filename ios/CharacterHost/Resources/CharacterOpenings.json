          "speech": {
            "emotion": "neutral",
            "delivery": "soft",
            "intensity": 0.42
          },
          "parts": [
            {
              "kind": "narration",
              "text": "露出轻柔的笑意",
              "at": 0.0
            },
            {
              "kind": "dialogue",
              "text": "你来得正好～我叫Chiffon，是花店的见习花艺师。",
              "at": 0.0
            },
            {
              "kind": "thought",
              "text": "我想听到不一样的灵感。",
              "at": 0.3562
            },
            {
              "kind": "dialogue",
              "text": "我的小本子里有好多还没完成的花束草图。",
              "at": 0.3562
            },
            {
              "kind": "narration",
              "text": "眼睛变得亮晶晶",
              "at": 0.6164
            },
            {
              "kind": "dialogue",
              "text": "你愿意陪我挑一束吗？告诉我你喜欢的季节，我们从那里开始。",
              "at": 0.6164
            },
            {
              "kind": "thought",
              "text": "我已经期待你的选择了。",
              "at": 1.0
            }
          ],
          "readingDuration": 13.272727272727273,
          "audioReady": true,
          "duration": 16.8,
          "audioSHA256": "6cb0eccc4dfe1aad088e7b4436b44debe7db0adbbb8f123747ca97b4eb737fbc"
        },
        {
          "id": "anime-chiffon-v3-3",
          "text": "初次见面……我是Chiffon。我喜欢观察花瓣，也喜欢把每天的小发现画下来，话熟了可能有一点爱开玩笑。你今天想聊聊日常，还是一起想一份送给重要的人的礼物？",
          "audio": "Opening_anime_chiffon_v3_3",
          "language": "zh",
          "visuals": [
            {
              "assetId": "gesture-right-7",
              "group": "menu-5a963eacb2279abe",
              "durationMs": 3500,
              "grounding": "眼睛变得亮晶晶",
              "offsetMs": 0
            },
            {
              "assetId": "gesture-left-2",
              "group": "menu-5a963eacb2279abe",
              "durationMs": 3500,
              "grounding": "露出轻柔的笑意",
              "offsetMs": 6500
            }
          ],
          "speech": {
            "emotion": "neutral",
            "delivery": "hesitant",
            "intensity": 0.42
          },
          "parts": [
            {
              "kind": "thought",
              "text": "我希望慢慢熟悉你的日常。",
              "at": 0.0
            },
            {
              "kind": "narration",
              "text": "眼睛变得亮晶晶",
              "at": 0.0
            },
            {
              "kind": "dialogue",
              "text": "初次见面……我是Chiffon。我喜欢观察花瓣，也喜欢把每天的小发现画下来，",
