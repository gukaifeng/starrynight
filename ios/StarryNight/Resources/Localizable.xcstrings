    "修改账号或密码后，其他设备需要重新登录；星夜号与全部资料保持不变。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改账号或密码后，其他设备需要重新登录；星夜号与全部资料保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改帳號或密碼後，其他裝置需要重新登入；星夜號與全部資料保持不變。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing your username or password signs out other devices. Your permanent ID and data stay the same."
          }
        }
      }
    },
    "需要填写当前密码验证身份。本设备会获得新的登录凭证。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要填写当前密码验证身份。本设备会获得新的登录凭证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要填寫目前密碼驗證身分。本裝置會取得新的登入憑證。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your current password to verify your identity. This device receives a new session."
          }
        }
      }
    },
