          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes the model, animations, backgrounds and audio. Requires about %@ of data plus installation space. Use Wi-Fi and keep the app open. You can cancel while downloading; once installed, you won’t need to download it again."
          }
