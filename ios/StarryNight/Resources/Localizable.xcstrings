            "value": "Account & sync"
          }
        }
      }
    },
    "在发现页选择角色，查看资料后订阅。消息页可以查看你们的故事，再进入会话。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在发现页选择角色，查看资料后订阅。消息页可以查看你们的故事，再进入会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在發現頁選擇角色，查看資料後訂閱。訊息頁可以查看你們的故事，再進入會話。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a character in Discover, read their profile and subscribe. Messages shows your shared story and opens the conversation."
          }
        }
      }
    },
    "角色头像旁可查看资料；右上角会话选项可调整取景、声音和氛围。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色头像旁可查看资料；右上角会话选项可调整取景、声音和氛围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "角色頭像旁可查看資料；右上角會話選項可調整取景、聲音和氛圍。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the character header for their profile. Conversation options at the top right adjust framing, sound and atmosphere."
          }
        }
      }
    },
    "不显示只隐藏消息条目。重置会清空该角色的对话和记忆，需要二次确认。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不显示只隐藏消息条目。重置会清空该角色的对话和记忆，需要二次确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不顯示只隱藏訊息項目。重置會清空該角色的對話和記憶，需要再次確認。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide removes a message entry from view. Reset clears that character’s conversation and memories after confirmation."
          }
        }
      }
    },
    "登录后，订阅、关注、设置、对话与共同记忆跟随账户。星夜号永久不变，登录账号可以修改。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，订阅、关注、设置、对话与共同记忆跟随账户。星夜号永久不变，登录账号可以修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入後，訂閱、關注、設定、對話與共同記憶跟隨帳戶。星夜號永久不變，登入帳號可以修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions, follows, settings, conversations and memories sync with your account. Your StarryNight ID stays permanent; your username can change."
          }
        }
      }
    },
    "微信、短信与邮箱验证仍在接入准备中，目前使用账号和密码登录。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微信、短信与邮箱验证仍在接入准备中，目前使用账号和密码登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "微信、簡訊與電子郵件驗證仍在準備中，目前使用帳號和密碼登入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WeChat, SMS and email verification are not yet connected. Use a username and password for now."
          }
        }
      }
