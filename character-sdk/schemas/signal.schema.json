{
  "type": "object",
  "properties": {
    "apiMajor": {
      "const": 1
    },
    "apiMinor": {
      "type": "integer",
      "minimum": 0
    },
    "actorId": {
      "type": "string",
      "maxLength": 64
    },
    "eventId": {
      "type": "string",
      "maxLength": 96
    },
    "turnId": {
      "type": "string",
      "maxLength": 96
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "eventName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
    },
    "emotion": {
      "type": "string",
      "maxLength": 32
    },
    "target": {
      "type": "string",
      "maxLength": 96
    },
    "selections": {
      "description": "Complete selected option IDs for performance.replace; target identifies their group.",
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "audioTime": {
      "type": "number",
      "minimum": 0,
      "maximum": 3600
    },
    "level": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "visemes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "weight"
        ],
        "additionalProperties": true
      },
      "maxItems": 16
    },
    "posture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,95}$"
              },
              "value": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "id",
              "value"
            ],
            "additionalProperties": true
          },
          "maxItems": 12
        }
      },
      "required": [
        "id",
        "parameters"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "apiMajor",
    "apiMinor",
    "actorId",
    "eventId",
    "turnId",
    "sequence",
    "eventName",
    "intensity"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xiaoban Character Signal 1.x"
}
